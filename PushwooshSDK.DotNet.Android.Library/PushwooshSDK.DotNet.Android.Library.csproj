<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PushwooshSDK.DotNet.Core\PushwooshSDK.DotNet.Core.csproj" />
    <ProjectReference Include="..\PushwooshSDK.DotNet.Android.Bindings\PushwooshSDK.DotNet.Android.Bindings.csproj" />
  </ItemGroup>
    <ItemGroup>
    <!-- 1.13.1 is a hard floor, not a courtesy bump: the native aar calls
         androidx.core.os.BundleCompat.getSerializable(Bundle, String, Class), which does not
         exist before androidx.core 1.13.0. See PushwooshSDK.DotNet.nuspec for the same pin. -->
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.13.1.2" />
    <!-- Rich media and in-app content run through com.pushwoosh.inapp.view.WebClient, which
         builds an androidx.webkit WebViewAssetLoader. Without this the WebView crashes the
         process with NoClassDefFoundError the moment it intercepts a request. -->
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.10.0.2" />
    <!-- Inbox UI (pushwoosh-inbox-ui aar, shipped in the same package) draws its list with
         androidx.recyclerview (LinearLayoutManager, ItemTouchHelper, DividerItemDecoration) and its
         chrome with com.google.android.material (AppBarLayout, Snackbar). Neither arrives
         transitively, so opening the inbox without these dies on NoClassDefFoundError — the same
         failure mode as the WebKit pin above. Versions are the newest that do not push
         AndroidX.Core past 1.13.1.2: RecyclerView 1.4.x wants Core 1.16+, Material 1.14.x wants
         Core 1.19 and Fragment 1.8.9. -->
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.3.2.5" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.10.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Arch.Core.Common" Version="2.2.0.10" />
    <PackageReference Include="Xamarin.AndroidX.Arch.Core.Runtime" Version="2.2.0.10" />
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.8.2.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.6.2.2" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.9.0.1" />
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="123.3.1.1" />
    <PackageReference Include="Xamarin.Firebase.Iid" Version="121.1.0.13" />
    <PackageReference Include="Xamarin.Firebase.Common" Version="120.4.2.1" />
    <PackageReference Include="Xamarin.Firebase.Installations" Version="117.2.0.1" />
    <PackageReference Include="Xamarin.Firebase.Annotations" Version="116.2.0.5" />
    <PackageReference Include="Xamarin.GooglePlayServices.Basement" Version="118.2.0.5" />
    <PackageReference Include="Xamarin.GooglePlayServices.Base" Version="118.2.0.5" />
    <PackageReference Include="Xamarin.GooglePlayServices.CloudMessaging" Version="117.1.0" />
    <PackageReference Include="Xamarin.AndroidX.SwipeRefreshLayout" Version="1.1.0.18" />
    <PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.1.4.10" />
  </ItemGroup>
</Project>