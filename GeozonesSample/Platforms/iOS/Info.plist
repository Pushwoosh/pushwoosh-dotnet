<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<key>Pushwoosh_APPID</key>
	<string>XXXXX-XXXXX</string>
	<!-- iOS shows these strings verbatim in the permission dialog, and App Review
	     rejects placeholders. Without them StartLocationTracking() returns without
	     starting anything and the native SDK only writes a log line. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Used to deliver notifications relevant to where you are, including in the background.</string>
	<key>NSLocationUsageDescription</key>
	<string>Used to deliver notifications relevant to where you are.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used to deliver notifications relevant to where you are.</string>
	<!-- Geozones are only useful while the app is backgrounded: entering a zone has
	     to be noticed when the user is not looking at the app. Without this mode the
	     sample stops tracking as soon as it leaves the foreground. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
