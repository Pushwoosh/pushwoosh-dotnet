<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Palette. Cold light ground, deep indigo for the product, and one warm
        coral reserved exclusively for inbound pushes — the moment the whole
        SDK exists for. Nothing else is allowed to use coral.
    -->
    <Color x:Key="PwGround">#EEF0F6</Color>
    <Color x:Key="PwSurface">#FFFFFF</Color>
    <Color x:Key="PwInk">#171634</Color>
    <Color x:Key="PwInkSoft">#6E7191</Color>
    <Color x:Key="PwIndigo">#3B2E7E</Color>
    <Color x:Key="PwIndigoSoft">#E6E3F5</Color>
    <Color x:Key="PwCoral">#FF5C39</Color>
    <Color x:Key="PwLine">#DDE0EC</Color>
    <Color x:Key="PwGood">#1F9D6B</Color>
    <Color x:Key="PwBad">#D64545</Color>

    <!-- Machine-produced values are always monospaced; prose is always sans. -->
    <OnPlatform x:Key="PwMono" x:TypeArguments="x:String">
        <On Platform="iOS, MacCatalyst" Value="Menlo" />
        <On Platform="Android" Value="monospace" />
    </OnPlatform>

    <Style x:Key="PwPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource PwGround}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Small uppercase label that names a region. Never used decoratively. -->
    <Style x:Key="PwEyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource PwInkSoft}" />
        <Setter Property="CharacterSpacing" Value="1.4" />
    </Style>

    <Style x:Key="PwTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{StaticResource PwInk}" />
    </Style>

    <Style x:Key="PwCardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource PwInk}" />
    </Style>

    <Style x:Key="PwBody" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource PwInkSoft}" />
    </Style>

    <Style x:Key="PwMonoValue" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PwMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource PwInk}" />
    </Style>

    <Style x:Key="PwCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PwSurface}" />
        <Setter Property="Stroke" Value="{StaticResource PwLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PwPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PwIndigo}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="PwQuietButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PwIndigoSoft}" />
        <Setter Property="TextColor" Value="{StaticResource PwIndigo}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="PwEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource PwInk}" />
        <Setter Property="PlaceholderColor" Value="#A3A6BC" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <Style x:Key="PwField" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PwGround}" />
        <Setter Property="Stroke" Value="{StaticResource PwLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
